{
  "name": "photo-uploader",
  "version": "1.0.0",
  "private": true,
  "description": "Responsive media uploader with admin control panel",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node --check server.js && esbuild node_modules/@vercel/blob/dist/client.js --bundle --format=esm --outfile=public/vercel-blob-client.mjs --platform=browser --define:global=globalThis"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.1",
    "cookie-session": "^2.1.0",
    "express": "^4.21.2",
    "googleapis": "^150.0.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
