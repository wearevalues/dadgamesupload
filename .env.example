# Copy to .env for local runs (`npm run dev`). On Vercel, set these per project
# (photo-uploader and valuesupload) under Settings → Environment Variables.

# --- Required on Vercel ---
# Admin login is disabled on Vercel until this is set.
ADMIN_PASSWORD=
# Any long random string. Signs admin login cookies; changing it signs everyone out.
SESSION_SECRET=
# Google service account with access to the Drive folder (paste the whole JSON on one line).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Locally you can point at the key file instead:
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# Vercel Blob store token. Needed for large/multi-file uploads, saved settings, and upload history.
BLOB_READ_WRITE_TOKEN=

# --- Optional ---
# Drive folder to upload into (the admin panel value wins if set there).
GOOGLE_DRIVE_FOLDER_ID=
# If set, uploaders must enter this code (case-insensitive) before uploading.
UPLOAD_ACCESS_CODE=
# If set, the nightly Blob cleanup job requires "Authorization: Bearer <CRON_SECRET>" (Vercel sends it automatically).
CRON_SECRET=

# Branding / page meta overrides (otherwise edited in /admin)
SITE_TITLE=
SITE_DESCRIPTION=
SITE_FAVICON_URL=
SITE_OG_IMAGE=
BRANDING_TITLE=
BRANDING_SUBTITLE=
BRANDING_LOGO_URL=
BRANDING_BACKGROUND_COLOR=
BRANDING_CARD_COLOR=
BRANDING_SURFACE_COLOR=
BRANDING_TEXT_COLOR=
